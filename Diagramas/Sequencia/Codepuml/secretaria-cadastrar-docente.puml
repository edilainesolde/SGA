@startuml
title UC03 - Secretaria - Cadastrar Docente

actor "Secretaria" as secretaria
boundary "Tela de Cadastro de Docente" as tela
control "Sistema SGA" as sistema
database "Banco de Dados" as bd

secretaria -> tela : Acessa cadastro de docente
tela --> secretaria : Exibe formulário

secretaria -> tela : Informa dados do docente
tela -> sistema : Envia dados

sistema -> sistema : Valida informações

alt Dados válidos
    sistema -> bd : Cadastra docente
    bd --> sistema : Cadastro realizado
    sistema --> tela : Confirma cadastro
    tela --> secretaria : Exibe sucesso
else Dados inválidos
    sistema --> tela : Retorna erros
    tela --> secretaria : Solicita correção
end

@enduml